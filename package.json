{
  "name": "suprematist-clock",
  "version": "2.0.0",
  "description": "Suprematist Clock 2.0 — Супрематистские аналоговые часы и прозрачный виджет (Win/macOS/Linux)",
  "desktopName": "suprematist-clock",
  "main": "electron/main.js",
  "author": {
    "name": "yunoarasaka",
    "email": "yunoarasaka@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://yunoarasaka.github.io/suprematist-clock-2/",
  "repository": {
    "type": "git",
    "url": "https://github.com/yunoarasaka/suprematist-clock-2.git"
  },
  "keywords": [
    "clock",
    "suprematism",
    "malevich",
    "electron",
    "widget"
  ],
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.yunoarasaka.suprematist-clock",
    "productName": "Suprematist Clock",
    "copyright": "Copyright © 2026 yunoarasaka",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "icons/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "icons/suprematist-clock.png",
      "maintainer": "yunoarasaka <yunoarasaka@users.noreply.github.com>",
      "artifactName": "SuprematistClock-${version}-linux.${ext}",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Comment": "Suprematist analog clock and transparent desktop widget.",
          "StartupWMClass": "suprematist-clock"
        }
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/suprematist-clock.png",
      "artifactName": "SuprematistClock-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "SuprematistClock-${version}-mac.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SuprematistClock-${version}-win-setup.${ext}"
    },
    "portable": {
      "artifactName": "SuprematistClock-${version}-win-portable.${ext}"
    },
    "executableName": "SuprematistClock",
    "deb": {
      "appArmorProfile": "build/apparmor-profile.tpl"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.1"
  }
}
