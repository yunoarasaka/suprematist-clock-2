{
  "name": "suprematist-clock",
  "version": "1.1.1",
  "description": "\u0421\u0443\u043f\u0440\u0435\u043c\u0430\u0442\u0438\u0441\u0442\u0441\u043a\u0438\u0435 \u0430\u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0435 \u0447\u0430\u0441\u044b \u2014 \u0432\u0435\u0431, Electron-\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u0432\u0438\u0434\u0436\u0435\u0442 (Win/macOS/Linux)",
  "main": "electron/main.js",
  "author": {
    "name": "yunoarasaka",
    "email": "yunoarasaka@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://yunoarasaka.github.io/suprematist-clock/",
  "repository": {
    "type": "git",
    "url": "https://github.com/yunoarasaka/suprematist-clock.git"
  },
  "keywords": [
    "clock",
    "suprematism",
    "malevich",
    "electron",
    "widget"
  ],
  "scripts": {
    "start": "electron .",
    "widget": "electron . --widget",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux:widget": "electron-builder --linux --config electron-builder.widget.yml --publish never",
    "dist:win:widget": "electron-builder --win --config electron-builder.widget.yml --publish never",
    "dist:mac:widget": "electron-builder --mac --config electron-builder.widget.yml --publish never"
  },
  "build": {
    "appId": "com.yunoarasaka.suprematist-clock",
    "productName": "Suprematist Clock",
    "copyright": "Copyright \u00a9 2026 yunoarasaka",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "icons/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "icons/suprematist-clock.png",
      "maintainer": "yunoarasaka <yunoarasaka@users.noreply.github.com>",
      "artifactName": "SuprematistClock-${version}-linux.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/suprematist-clock.png",
      "artifactName": "SuprematistClock-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "SuprematistClock-${version}-mac.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SuprematistClock-${version}-win-setup.${ext}"
    },
    "portable": {
      "artifactName": "SuprematistClock-${version}-win-portable.${ext}"
    },
    "executableName": "SuprematistClock"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
